---
// Contributions by status (one stacked bar) and by project (one bar each). Every segment filters the Work list.
import { projectLabel } from '../data/contributions';
import { statusBadge, type BadgeVariant } from '../lib/status';
import type { LiveContribution } from '../lib/github';
interface Props { list: LiveContribution[]; }
const { list } = Astro.props;
const order: BadgeVariant[] = ['merged', 'review', 'discussion', 'closed'];
const names: Record<string, string> = { merged: 'Merged', review: 'In review', discussion: 'Discussion', closed: 'Closed' };
const filterFor: Record<string, string> = { merged: 'merged', review: 'open', discussion: 'discussion', closed: 'closed' };
const byStatus = order.map((v) => ({ v, n: list.filter((c) => statusBadge(c.status).variant === v).length })).filter((x) => x.n);
const projects = [...new Set(list.map((c) => c.project))]
  .map((p) => ({ p, items: list.filter((c) => c.project === p) }))
  .map((x) => ({ ...x, seg: order.map((v) => ({ v, n: x.items.filter((c) => statusBadge(c.status).variant === v).length })).filter((s) => s.n) }))
  .sort((a, b) => b.items.length - a.items.length);
const max = Math.max(...projects.map((p) => p.items.length));
---
<figure class="wb" data-observe>
  <figcaption class="wb-cap"><b>{list.length} contributions</b><span>by status and by project</span></figcaption>
  <div class="wb-stack" role="img" aria-label={byStatus.map((s) => `${s.n} ${names[s.v].toLowerCase()}`).join(', ')}>
    {byStatus.map((s, i) => <a href={`/work/?status=${filterFor[s.v]}`} class={`wb-seg wb--${s.v}`} style={`flex:${s.n};--i:${i}`} title={`${names[s.v]}: ${s.n}`}><span>{s.n}</span></a>)}
  </div>
  <p class="wb-legend">{byStatus.map((s) => <span><i class={`wb--${s.v}`}></i>{names[s.v]}</span>)}</p>
  <ul class="wb-list" role="list">
    {projects.map((x, i) => (
      <li style={`--i:${i}`}>
        <a href={`/work/?project=${encodeURIComponent(x.p)}`} class="wb-row">
          <span class="wb-name">{projectLabel(x.p)}</span>
          <span class="wb-bar" style={`--w:${(x.items.length / max) * 100}%`}>{x.seg.map((s) => <span class={`wb--${s.v}`} style={`flex:${s.n}`}></span>)}</span>
          <span class="wb-n">{x.items.length}</span><span class="visually-hidden"> contributions, show only this project</span>
        </a>
      </li>
    ))}
  </ul>
</figure>
<style>
  .wb { margin: 0; display: grid; gap: 14px; }
  .wb-cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .wb-cap b { font-family: var(--font-display); font-weight: 500; font-size: var(--step-2); color: var(--ink); }
  .wb-cap span { font-size: var(--step--1); color: var(--muted); }
  .wb-stack { display: flex; gap: 3px; height: 40px; }
  .wb-seg { display: grid; place-items: center; border-radius: 8px; color: #fff; font-weight: 700; font-size: var(--step--1); transform-origin: left; transition: filter var(--t-fast); }
  .wb-seg:hover { filter: brightness(1.1); }
  .wb-seg.wb--discussion, .wb-seg.wb--closed { color: var(--ink); }
  .wb--merged { background: #1f7a50; } .wb--review { background: #c98a00; } .wb--discussion { background: #c4d8f5; } .wb--closed { background: #e3e9f0; }
  .wb-seg.wb--review { color: var(--c-ink); }
  .wb-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: var(--step--1); color: var(--ink-2); }
  .wb-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .wb-legend i { width: 12px; height: 12px; border-radius: 3px; }
  .wb-list { list-style: none; display: grid; gap: 2px; padding-top: 12px; border-top: 1px solid var(--rule); }
  .wb-row { display: grid; grid-template-columns: 11.5em minmax(0, 1fr) 1.6em; gap: 12px; align-items: center; padding: 7px 8px; margin-inline: -8px; border-radius: 8px; font-size: var(--step--1); color: var(--ink-2); transition: background-color var(--t-fast); }
  .wb-row:hover { background: var(--fill); color: var(--ink); }
  .wb-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wb-bar { display: flex; gap: 2px; width: var(--w); height: 14px; transform-origin: left; }
  .wb-bar span { border-radius: 3px; }
  .wb-n { text-align: right; font-weight: 700; color: var(--ink); }
  :global(.js) .wb .wb-bar, :global(.js) .wb .wb-seg { transform: scaleX(0); transition: transform 0.8s var(--ease-out) calc(var(--i) * 90ms + 200ms); }
  :global(.js) .wb[data-drawn] .wb-bar, :global(.js) .wb[data-drawn] .wb-seg { transform: none; }
</style>
