---
// Workshop illustration for "Pizzeria del Compilator": a pizza on its board, with typed labels. Decorative.
---
<svg class="art" viewBox="0 0 320 240" aria-hidden="true">
  <ellipse cx="150" cy="218" rx="118" ry="10" fill="#0e1726" opacity="0.08" />
  <!-- board -->
  <rect x="236" y="116" width="74" height="22" rx="11" fill="#c98a4b" stroke="#0e1726" stroke-width="3" />
  <circle cx="148" cy="128" r="92" fill="#e2a868" stroke="#0e1726" stroke-width="3" />
  <!-- pizza -->
  <g class="pz">
    <circle cx="148" cy="128" r="76" fill="#f2b25c" stroke="#0e1726" stroke-width="3" />
    <circle cx="148" cy="128" r="64" fill="#d9482c" />
    <path d="M100 104c14-22 44-30 66-20 20 8 36 26 32 48-4 24-28 40-54 38-26-2-48-18-50-40-1-10 1-18 6-26Z" fill="#ffe08a" />
    <g fill="#b3261e" stroke="#0e1726" stroke-width="2"><circle cx="122" cy="104" r="10" /><circle cx="170" cy="100" r="10" /><circle cx="182" cy="146" r="10" /><circle cx="128" cy="156" r="10" /></g>
    <g fill="#fff" opacity=".45"><circle cx="119" cy="100" r="3" /><circle cx="167" cy="96" r="3" /><circle cx="179" cy="142" r="3" /><circle cx="125" cy="152" r="3" /></g>
    <g fill="#24875a" stroke="#0e1726" stroke-width="2" stroke-linejoin="round"><path d="M146 124c8-12 22-12 24 0-10 4-16 6-24 0Z" /><path d="M104 132c6-10 18-10 20 0-8 3-13 5-20 0Z" /></g>
    <path d="M148 52v152M72 128h152" stroke="#0e1726" stroke-width="2" opacity=".25" />
  </g>
  <!-- type labels -->
  <g class="lbl lbl--a" font-family="JetBrains Mono Variable, monospace" font-size="14">
    <rect x="196" y="30" width="112" height="34" rx="9" fill="#fff" stroke="#0e1726" stroke-width="3" />
    <text x="210" y="52" fill="#1d5fb8">Topping[]</text>
  </g>
  <g class="lbl lbl--b" font-family="JetBrains Mono Variable, monospace" font-size="14">
    <rect x="6" y="176" width="104" height="34" rx="9" fill="#fff" stroke="#0e1726" stroke-width="3" />
    <text x="18" y="198" fill="#0e1726">size: <tspan fill="#24875a">"L"</tspan></text>
  </g>
  <!-- steam -->
  <g class="steam" fill="none" stroke="#0e1726" stroke-width="2.5" stroke-linecap="round" opacity=".35"><path d="M120 34c-6-8 6-12 0-20" /><path d="M148 30c-6-8 6-12 0-20" /></g>
</svg>
<style>
  .art { width: 100%; height: auto; display: block; overflow: visible; }
  .pz { transform-origin: 148px 128px; transition: transform 0.9s cubic-bezier(0.34, 1.3, 0.64, 1); }
  :global(a:hover) .pz { transform: rotate(30deg); }
  .lbl { animation: float 4.5s ease-in-out infinite; }
  .lbl--b { animation-delay: -2.2s; }
  .steam path { animation: steam 2.8s ease-in-out infinite; }
  .steam path:nth-child(2) { animation-delay: -1.4s; }
  @keyframes float { 50% { transform: translateY(-6px); } }
  @keyframes steam { 0% { opacity: 0; transform: translateY(6px); } 50% { opacity: 0.4; } 100% { opacity: 0; transform: translateY(-8px); } }
</style>
