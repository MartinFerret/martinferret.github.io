---
// Kind tag: a colored icon tile plus a label. Distinct from status badges (which are tinted pills).
type Kind = 'lab' | 'podcast' | 'workshop' | 'pr' | 'community' | 'repo' | 'talk' | 'issue' | 'answer' | 'article' | 'milestone';
interface Props { kind: Kind; }
const { kind } = Astro.props;
const tone: Record<Kind, string> = { lab: 'violet', podcast: 'coral', workshop: 'amber', pr: 'blue', community: 'mint', repo: 'neutral', talk: 'coral', issue: 'violet', answer: 'amber', article: 'blue', milestone: 'mint' };
const icons: Record<Kind, string> = {
  lab: '<path d="M8 3h4M9 3v5l-4.5 7.5A1.5 1.5 0 0 0 5.8 18h8.4a1.5 1.5 0 0 0 1.3-2.5L11 8V3"/><path d="M6.5 13h7"/>',
  podcast: '<rect x="7.5" y="2.5" width="5" height="9" rx="2.5"/><path d="M4.5 9.5a5.5 5.5 0 0 0 11 0M10 15v3M7 18h6"/>',
  workshop: '<rect x="3" y="4" width="14" height="9" rx="1.5"/><path d="M1.5 16h17M8 7.5l-2 1.5 2 1.5M12 7.5l2 1.5-2 1.5"/>',
  pr: '<circle cx="5" cy="4" r="2"/><circle cx="5" cy="16" r="2"/><circle cx="15" cy="16" r="2"/><path d="M5 6v8M15 14V8a3 3 0 0 0-3-3H9m2-2-2 2 2 2"/>',
  community: '<circle cx="7" cy="7" r="2.5"/><circle cx="14" cy="8" r="2"/><path d="M2.5 16a4.5 4.5 0 0 1 9 0M11.5 15.5a3.5 3.5 0 0 1 6 -1"/>',
  repo: '<path d="M5 3h10v14l-2-1.5-2 1.5V3"/><path d="M5 3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"/>',
  talk: '<rect x="7.5" y="2.5" width="5" height="9" rx="2.5"/><path d="M4.5 9.5a5.5 5.5 0 0 0 11 0M10 15v3"/>',
  issue: '<path d="M3.5 5h13v8H9l-4 3v-3H3.5z"/><path d="M7 8.5h6M7 11h3.5"/>',
  answer: '<circle cx="10" cy="10" r="7"/><path d="M8 8a2 2 0 1 1 2.8 1.8c-.6.3-.8.7-.8 1.2"/><circle cx="10" cy="13.6" r=".6" fill="currentColor"/>',
  article: '<path d="M6 3h6l3 3v11H6z"/><path d="M12 3v3h3M8.5 10h4M8.5 13h4"/>',
  milestone: '<path d="M5 18V3M5 4h9l-2 3 2 3H5"/>',
};
---
<span class={`tag tag--${tone[kind]}`}>
  <span class="tag-ic" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[kind]} /></span>
  <span class="tag-tx"><slot /></span>
</span>
