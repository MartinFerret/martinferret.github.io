---
import { nav, site } from '../data/site';
import { hasWriting } from '../lib/writing';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path.startsWith(href);
const showWriting = await hasWriting();
const items = nav.filter((n) => n.href !== '/writing/' || showWriting);
---
<header class="site-header" id="site-header" transition:persist data-open="false">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {items.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined} data-nav-link>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-tools">
      <button class="icon-btn search-btn" type="button" data-search-open aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="label">Search</span><span class="visually-hidden">Search the site</span>
        <kbd data-search-kbd>Ctrl K</kbd>
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" data-nav-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span class="visually-hidden" data-nav-label>Open menu</span>
      </button>
    </div>
  </div>
  <div class="menu-panel" id="menu-panel">
    <ul>
      {items.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined} data-nav-link>{n.label}</a></li>)}
      <li><a class="menu-extra" href="/timeline/" data-nav-link>Timeline</a></li>
    </ul>
  </div>
</header>
