---
// The one status badge used everywhere. Label + icon + color: color is never the only signal.
import { statusBadge, type AnyStatus } from '../lib/status';
interface Props { status: AnyStatus; }
const { status } = Astro.props;
const b = statusBadge(status);
const icons: Record<string, string> = {
  merged: '<circle cx="5" cy="4" r="2"/><circle cx="5" cy="16" r="2"/><circle cx="15" cy="10" r="2"/><path d="M5 6v8M5 6c0 4 4 4 8 4"/>',
  review: '<circle cx="10" cy="10" r="7"/><path d="M10 6v4l3 2"/>',
  discussion: '<path d="M4 5h12v8H9l-4 3v-3H4z"/>',
  answered: '<path d="M4 5h12v8H9l-4 3v-3H4z"/><path d="m7.5 9 2 2 3.5-3.5"/>',
  closed: '<circle cx="10" cy="10" r="7"/><path d="M6 14 14 6"/>',
  confirmed: '<circle cx="10" cy="10" r="7"/><path d="m6.5 10 2.5 2.5 4.5-5"/>',
  rejected: '<circle cx="10" cy="10" r="7"/><path d="m7 7 6 6M13 7l-6 6"/>',
  'open-question': '<circle cx="10" cy="10" r="7"/><path d="M8 8a2 2 0 1 1 2.8 1.8c-.6.3-.8.7-.8 1.2"/><circle cx="10" cy="13.6" r=".6" fill="currentColor"/>',
  upcoming: '<rect x="3.5" y="4.5" width="13" height="12" rx="2"/><path d="M3.5 8.5h13M7 3v3M13 3v3"/>',
  delivered: '<circle cx="10" cy="10" r="7"/><path d="m6.5 10 2.5 2.5 4.5-5"/>',
};
const key = status === 'open' ? 'review' : status;
---
<span class={`badge badge--${b.variant}`} data-status={status}>
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[key] ?? icons.discussion} />
  {b.label}
</span>
