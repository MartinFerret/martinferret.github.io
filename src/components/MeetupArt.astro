---
// Meetup illustrations. "people": three faces chatting. "call": a laptop with a video call. Decorative.
interface Props { side?: 'left' | 'right'; }
const { side = 'left' } = Astro.props;
---
{side === 'left' ? (
  <svg class="art" viewBox="0 0 240 220" aria-hidden="true">
    <g class="bub">
      <rect x="40" y="8" width="150" height="50" rx="18" fill="#fff" stroke="#0e1726" stroke-width="3" />
      <path d="M86 58l-6 16 20-16" fill="#fff" stroke="#0e1726" stroke-width="3" stroke-linejoin="round" />
      <text x="62" y="41" font-family="Funnel Display Variable, sans-serif" font-size="21" fill="#0e1726">What's up?</text>
    </g>
    <ellipse cx="120" cy="206" rx="96" ry="8" fill="#0e1726" opacity="0.08" />
    <g stroke="#0e1726" stroke-width="3">
      <path d="M22 204a38 38 0 0 1 76 0Z" fill="#7b5cd6" /><circle cx="60" cy="140" r="26" fill="#f6c7a1" /><path d="M34 136a26 26 0 0 1 52 0c-10-8-20-10-26-4-8-6-18-4-26 4Z" fill="#3b2a1e" />
      <path d="M142 204a38 38 0 0 1 76 0Z" fill="#24875a" /><circle cx="180" cy="140" r="26" fill="#a86b45" /><path d="M156 132c4-18 44-18 48 0-8-4-16-2-24-6-8 4-16 2-24 6Z" fill="#0e1726" />
      <path d="M80 206a40 40 0 0 1 80 0Z" fill="#1d5fb8" /><circle cx="120" cy="128" r="28" fill="#f2d3b3" /><path d="M92 124a28 28 0 0 1 56 0l-6-6-8 4-8-6-8 6-8-4-8 4Z" fill="#d9482c" />
    </g>
    <g fill="#0e1726"><circle cx="52" cy="144" r="2.5" /><circle cx="68" cy="144" r="2.5" /><circle cx="112" cy="132" r="2.5" /><circle cx="128" cy="132" r="2.5" /><circle cx="172" cy="144" r="2.5" /><circle cx="188" cy="144" r="2.5" /></g>
    <g fill="none" stroke="#0e1726" stroke-width="2.5" stroke-linecap="round"><path d="M54 152q6 5 12 0" /><path d="M112 140q8 7 16 0" /><path d="M174 152q6 5 12 0" /></g>
  </svg>
) : (
  <svg class="art" viewBox="0 0 240 220" aria-hidden="true">
    <g class="bub">
      <rect x="70" y="6" width="150" height="50" rx="18" fill="#ffd166" stroke="#0e1726" stroke-width="3" />
      <path d="M176 56l8 16-24-16" fill="#ffd166" stroke="#0e1726" stroke-width="3" stroke-linejoin="round" />
      <text x="90" y="39" font-family="Funnel Display Variable, sans-serif" font-size="20" fill="#0e1726">On se voit !</text>
    </g>
    <ellipse cx="120" cy="206" rx="100" ry="8" fill="#0e1726" opacity="0.08" />
    <rect x="34" y="82" width="172" height="110" rx="10" fill="#fff" stroke="#0e1726" stroke-width="3" />
    <path d="M14 198h212l-12 -8H26Z" fill="#c4d8f5" stroke="#0e1726" stroke-width="3" stroke-linejoin="round" />
    <g stroke="#0e1726" stroke-width="2">
      <rect x="46" y="94" width="72" height="40" rx="6" fill="#e6eefa" /><rect x="122" y="94" width="72" height="40" rx="6" fill="#dcf3e6" />
      <rect x="46" y="140" width="72" height="40" rx="6" fill="#efeafd" /><rect x="122" y="140" width="72" height="40" rx="6" fill="#ffe6df" />
    </g>
    <g stroke="#0e1726" stroke-width="2">
      <circle cx="82" cy="110" r="8" fill="#f2d3b3" /><path d="M70 134a12 12 0 0 1 24 0" fill="#1d5fb8" />
      <circle cx="158" cy="110" r="8" fill="#a86b45" /><path d="M146 134a12 12 0 0 1 24 0" fill="#24875a" />
      <circle cx="82" cy="156" r="8" fill="#f6c7a1" /><path d="M70 180a12 12 0 0 1 24 0" fill="#7b5cd6" />
      <circle cx="158" cy="156" r="8" fill="#e8b48f" /><path d="M146 180a12 12 0 0 1 24 0" fill="#d9482c" />
    </g>
    <circle class="live" cx="186" cy="102" r="4" fill="#d9482c" />
  </svg>
)}
<style>
  .art { width: 100%; max-width: 240px; height: auto; display: block; margin-inline: auto; overflow: visible; }
  .bub { animation: bob 4.5s ease-in-out infinite; }
  .live { animation: blink 1.4s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-6px); } }
  @keyframes blink { 50% { opacity: 0.3; } }
</style>
